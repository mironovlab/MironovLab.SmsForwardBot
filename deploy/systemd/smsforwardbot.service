[Unit]
Description=SmsForwardBot
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=smsforwardbot
Group=smsforwardbot
WorkingDirectory=/opt/smsforwardbot
ExecStart=/opt/smsforwardbot/MironovLab.SmsForwardBot
StateDirectory=smsforwardbot
StateDirectoryMode=0700
Environment=StateFile=/var/lib/smsforwardbot/bot-state.json
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
